{
  "name": "nest-auth-example",
  "version": "0.0.1",
  "private": true,
  "description": "Nest.js authentication with Passport. Realworld example",
  "license": "MIT",
  "author": "Jaime Leonardo Suncin Cruz <leosuncin@gmail.com>",
  "bin": {
    "cli": "dist/cli.js"
  },
  "scripts": {
    "build": "nest build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "start": "node dist/main.js",
    "start:debug": "NODE_OPTIONS='-r dotenv-mono/load' nest start --debug --watch",
    "start:dev": "NODE_OPTIONS='-r dotenv-mono/load' nest start --watch",
    "start:repl": "NODE_OPTIONS='-r dotenv-mono/load' nest start --entryFile repl",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --test-timeout=0",
    "test:e2e": "vitest run --config ./test/vitest.config.mts",
    "test:watch": "vitest",
    "typeorm": "typeorm-ts-node-commonjs",
    "typeorm-extension": "ts-node -r tsconfig-paths/register node_modules/typeorm-extension/bin/cli.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "express-session": "^1.19.0",
    "nest-commander": "^3.20.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.0.0",
    "typeorm-extension": "4.0.0-beta.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@electric-sql/pglite": "^0.5.3",
    "@faker-js/faker": "^10.5.0",
    "@fast-check/vitest": "^0.4.1",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@suites/di.nestjs": "^3.1.0",
    "@suites/doubles.vitest": "^3.1.0",
    "@suites/unit": "^3.1.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.41",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/k6": "^2.0.0",
    "@types/node": "^26.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.0",
    "@types/tv4": "^1.2.33",
    "@usebruno/cli": "^3.4.2",
    "@vitest/coverage-v8": "^4.1.9",
    "factory.io": "^0.1.4",
    "fast-check": "^4.8.0",
    "nest-commander-testing": "^3.5.1",
    "nock": "^14.0.15",
    "node-mocks-http": "^1.17.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm-pglite": "^0.3.4",
    "typescript": "6.0.3",
    "ultracite": "7.8.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "@suites/di.nestjs@3.1.0": true,
    "@suites/doubles.vitest@3.1.0": true,
    "unrs-resolver@1.12.2": true,
    "protobufjs@8.6.3": true,
    "protobufjs@7.6.4": true
  }
}
